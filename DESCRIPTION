Type: Package
Package: slca
Title: Structural Modeling for Multiple Latent Class Variables
Version: 1.4.3
Authors@R: c(
    person("Youngsun", "Kim", , "yskstat@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0001-8003-1939")),
    person("Hwan", "Chung", , "hwanch@korea.ac.kr", role = "aut",
           comment = c(ORCID = "0000-0002-8969-9086"))
